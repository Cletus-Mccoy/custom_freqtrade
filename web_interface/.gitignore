# FreqTrade Web Interface - Git Ignore File
# Python/Flask project patterns

# ============================================================================
# Python Cache & Compiled Files
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ============================================================================
# Virtual Environments
# ============================================================================
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
pythonenv*/

# ============================================================================
# Flask Specific
# ============================================================================
instance/
.webassets-cache
*.db
*.sqlite
*.sqlite3

# ============================================================================
# Environment Variables & Secrets
# ============================================================================
.env
.env.local
.env.*.local
*.env
.flaskenv

# Secrets and API keys
config/secrets.json
**/exchange_secrets.json
user_data/ftapikeys/*/exchange_secrets.json

# Cloudflare tunnel credentials
cloudflared/config.yml
cloudflared/*.json
cloudflared/*.pem

# ============================================================================
# User Data (Optional - Uncomment if needed)
# ============================================================================
# Uncomment these if you want to exclude user-generated content from git
# user_data/strategies/*.py
# user_data/pairlists/*.json
# user_data/*.json
# !user_data/config.example.json

# But always exclude logs and temporary data
user_data/*.log
user_data/tmp/
user_data/backups/

# ============================================================================
# IDE & Editor Settings
# ============================================================================
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.history/

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ============================================================================
# Operating System Files
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============================================================================
# Testing & Coverage
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ============================================================================
# Build & Distribution
# ============================================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================================
# Documentation
# ============================================================================
docs/_build/
site/
.mkdocs/

# ============================================================================
# Jupyter Notebooks (if used for development)
# ============================================================================
.ipynb_checkpoints/
*.ipynb

# ============================================================================
# Docker (Keep compose files, exclude runtime data)
# ============================================================================
# Keep docker-compose.yml but exclude these:
.docker/
docker-compose.override.yml
docker-compose.local.yml

# ============================================================================
# Logs & Temporary Files
# ============================================================================
*.log
*.pot
*.pyc
pip-log.txt
pip-delete-this-directory.txt

# Flask/Gunicorn logs
logs/
*.log.*

# Cloudflared logs
cloudflared.log

# ============================================================================
# Backup Files
# ============================================================================
*.bak
*.backup
*.orig
*.rej
*~
*.swp

# Backup directories (often created during refactoring)
*_backup/
web_interface copy/

# ============================================================================
# Project Specific
# ============================================================================
# Node modules (if any frontend tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Static file builds (if using webpack/rollup later)
static/dist/
static/build/

# Temporary development files
TODO.txt
NOTES.txt
scratch.py
test_local.py

# ============================================================================
# Security & Credentials
# ============================================================================
# Never commit these:
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ============================================================================
# Miscellaneous
# ============================================================================
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
